{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://glucom-production.up.railway.app/api/$1"
    },
    {
      "src": "/predict",
      "dest": "https://glucom-production.up.railway.app/predict"
    },
    {
      "src": "/health",
      "dest": "https://glucom-production.up.railway.app/health"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

