# ==============================================================================
# GLUCOM — PRODUCTION CLOUD ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Network
PORT=5000
HOST=0.0.0.0
ENVIRONMENT=production

# Database
# If set, uses PostgreSQL (Render Postgres, Supabase, Neon); otherwise defaults to persistent SQLite at /app/data/glucom.db
DATABASE_URL=sqlite:////app/data/glucom.db

# Model Configuration
MODEL_PATH=/app/checkpoints/best_model.pth
DEVICE=cpu

# Optional Server-side Gemini 3.8 Flash Assistant
# (Leave empty if using deterministic offline rule-based medical fallback)
GEMINI_API_KEY=

# Matplotlib & Albumentations Optimization
NO_ALBUMENTATIONS_UPDATE=1
MPLCONFIGDIR=/app/.matplotlib_cache

